{
  "name": "@decodo/langchain-ts",
  "version": "0.0.0-semantic-release",
  "description": "LangChain tools for Decodo's Scraper API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "example": "tsx examples/basic-usage",
    "example:agent-universal": "tsx examples/agent-universal",
    "example:agent-google": "tsx examples/agent-google",
    "example:agent-amazon": "tsx examples/agent-amazon",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "langchain",
    "decodo",
    "scraper",
    "web-scraping",
    "api",
    "tools"
  ],
  "author": "Decodo",
  "license": "MIT",
  "dependencies": {
    "@decodo/sdk-ts": "^2.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.6.9",
    "dotenv": "^17.2.1",
    "zod": "3.25.32"
  },
  "devDependencies": {
    "@langchain/langgraph": "^0.4.6",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Decodo/decodo-langchain-ts.git"
  },
  "files": [
    "dist"
  ]
}
